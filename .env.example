# Copy to .env and fill in locally. Never commit a filled-in copy.
# With AI_ENABLED=false the application starts and the AI endpoint returns 503.

AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# The portal shows the version to use next to the deployment. The gpt-5 family
# is served through the Responses API and needs a preview version.
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# On a reasoning model this budget covers reasoning tokens as well as the
# answer. 900 was too small for gpt-5-mini: it returned nothing.
AI_MAX_OUTPUT_TOKENS=2000
# minimal | low | medium | high, or empty to let the model decide. Higher costs
# more tokens and more seconds; see app/config.py for measured figures.
AI_REASONING_EFFORT=low
